# Copia este archivo como .env y llena los valores (en Render: Environment > Add variable)
STORE_NAME=Catálogo de Bela · Consultora independiente
CYCLE_NAME=Ciclo 17A
WHATSAPP_NUMBER=573148616132

# Contraseña del manager (ve la base de datos de pedidos verificados y el consolidado para Natura)
MANAGER_PASSWORD=cambia-esta-clave
# Opcional: contraseña de quien atiende el WhatsApp (solo ve pendientes y los verifica)
ATTENDANT_PASSWORD=
# Texto largo y aleatorio para firmar las sesiones
SESSION_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# Base de datos PostgreSQL (Neon / Render). Si se deja vacío, usa un archivo local solo para pruebas.
DATABASE_URL=

# Asistente de IA (opcional). Sin clave funciona con búsqueda por palabras.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
